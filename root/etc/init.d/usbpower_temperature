#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	config_load usbpower_temperature
	config_get_bool enabled settings enabled 0
	[ "$enabled" = "1" ] || return 0

	if ! /usr/sbin/usbpowerd check; then
		logger -t usbpower_temperature "configuration invalid, not starting"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/usbpowerd run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
